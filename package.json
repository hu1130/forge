{
  "name": "local-codex-like",
  "version": "0.22.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "concurrently -k -n daemon,web -c yellow,blue \"pnpm --filter @forge/daemon dev\" \"pnpm --filter @forge/web dev\"",
    "dev:cloud": "concurrently -k -n cloud,daemon,web -c green,yellow,blue \"pnpm --filter @forge/cloud-api dev\" \"pnpm --filter @forge/daemon dev\" \"pnpm --filter @forge/web dev\"",
    "dev:desktop": "concurrently -k -n daemon,web,desktop -c yellow,blue,magenta \"pnpm --filter @forge/daemon dev\" \"pnpm --filter @forge/web dev\" \"wait-on http://127.0.0.1:5173 http://127.0.0.1:4782/api/health && pnpm --filter @forge/desktop dev\"",
    "cloud:preflight": "pnpm --filter @forge/cloud-api build && pnpm --filter @forge/cloud-api preflight",
    "cloud:backup": "node ./scripts/mysql-maintenance.mjs backup",
    "cloud:restore": "node ./scripts/mysql-maintenance.mjs restore",
    "build": "pnpm -r --if-present build",
    "dist:win": "pnpm --filter @forge/desktop dist",
    "typecheck": "pnpm -r --if-present typecheck",
    "p0:probe": "node ./spikes/app-server/handshake.mjs",
    "queue:probe": "pnpm --filter @forge/daemon build && node ./spikes/app-server/queue-probe.mjs",
    "test": "pnpm --filter @forge/cloud-api build && pnpm --filter @forge/daemon build && node --test ./tests/**/*.test.mjs",
    "test:mysql": "pnpm --filter @forge/cloud-api build && node ./scripts/verify-mysql-tenant-isolation.mjs",
    "capture:ui": "pnpm --filter @forge/desktop exec electron ../../scripts/capture-web-ui.cjs",
    "brand:assets": "pnpm --filter @forge/desktop exec electron ../../scripts/generate-brand-assets.cjs",
    "test:ui": "pnpm build && pnpm --filter @forge/desktop exec electron ../../scripts/smoke-web-ui.cjs",
    "release:verify": "node ./scripts/verify-release.mjs",
    "release:verify:commercial": "node ./scripts/verify-release.mjs --commercial"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "esbuild": "0.27.2",
    "wait-on": "^8.0.4"
  },
  "engines": {
    "node": ">=24"
  }
}
