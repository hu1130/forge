# Forge Cloud API development only. Replace every credential outside local development.
DATABASE_URL=mysql://forge_app:forge_app_dev_only@127.0.0.1:33069/forge
FORGE_CLOUD_MIGRATION_DATABASE_URL=mysql://forge_migrator:forge_dev_only@127.0.0.1:33069/forge
FORGE_CLOUD_HOST=127.0.0.1
FORGE_CLOUD_PORT=4790
FORGE_CLOUD_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FORGE_CLOUD_PUBLIC_WEB_URL=http://127.0.0.1:5173/?cloud=1
FORGE_CLOUD_DB_POOL_SIZE=10
FORGE_CLOUD_LOG_LEVEL=info
# Production only: use a verified sender/domain and store the key in the hosting platform's secret manager.
FORGE_CLOUD_RESEND_API_KEY=
FORGE_CLOUD_EMAIL_FROM=
# Set to 1 only when Cloud API runs behind a trusted reverse proxy.
FORGE_CLOUD_TRUST_PROXY=0
# Operations only. Keep backup and restore credentials outside application containers.
FORGE_CLOUD_BACKUP_DATABASE_URL=
FORGE_CLOUD_BACKUP_DIR=
FORGE_CLOUD_RESTORE_DATABASE_URL=
